{
  "name": "opentui-git",
  "version": "0.1.7",
  "private": true,
  "description": "A lazygit-style terminal UI git client built with OpenTUI, SolidJS, and Bun",
  "workspaces": [
    "packages/core",
    "packages/server"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/core --conditions=browser src/index.ts",
    "dev:tui": "bun run --cwd packages/core --conditions=browser src/index.ts",
    "dev:server": "bun run --cwd packages/server dev",
    "start": "bun run --cwd packages/core --conditions=browser src/index.ts",
    "build": "bun run --cwd packages/core build",
    "build:binary": "bun run --cwd packages/core build:binary",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/server typecheck",
    "generate": "bun run --cwd packages/server generate && bun run --cwd packages/core generate",
    "generate:server": "bun run --cwd packages/server generate",
    "generate:core": "bun run --cwd packages/core generate",
    "clean": "rm -rf packages/*/node_modules packages/*/dist node_modules bun.lock"
  },
  "keywords": [
    "git",
    "tui",
    "terminal",
    "opentui",
    "solidjs",
    "bun",
    "lazygit"
  ],
  "author": "opentui-git",
  "license": "MIT",
  "resolutions": {
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
