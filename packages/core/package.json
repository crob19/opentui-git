{
  "name": "@opentui-git/core",
  "version": "0.1.7",
  "description": "Core package: CLI and TUI for opentui-git",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./git": "./src/git/index.ts",
    "./git/types": "./src/git/types.ts",
    "./utils/file-tree": "./src/tui/utils/file-tree.ts",
    "./utils/diff-parser": "./src/tui/utils/diff-parser.ts",
    "./utils/language-detection": "./src/tui/utils/language-detection.ts",
    "./utils/syntax-highlighting": "./src/tui/utils/syntax-highlighting.ts"
  },
  "bin": {
    "opentui-git": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --conditions=browser src/index.ts",
    "start": "bun run --conditions=browser src/index.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "tui",
    "terminal",
    "opentui",
    "solidjs",
    "bun",
    "lazygit"
  ],
  "author": "opentui-git",
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "^0.1.67",
    "@opentui/solid": "^0.1.67",
    "@types/diff": "^7.0.2",
    "diff": "^8.0.2",
    "shiki": "^3.20.0",
    "simple-git": "^3.30.0",
    "solid-js": "1.9.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
