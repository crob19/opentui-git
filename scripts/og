#!/usr/bin/env bash
# Launch the locally-built opentui-git desktop app against a given folder.
# Usage: og [path]   (defaults to $PWD)
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd "$(dirname "$SOURCE")/.." && pwd)"
TARGET="${1:-$PWD}"

if [ ! -d "$TARGET" ]; then
  echo "og: target directory does not exist: $TARGET" >&2
  exit 1
fi

BUNDLE="$REPO/packages/desktop/out/main/index.js"
if [ ! -f "$BUNDLE" ]; then
  echo "og: no bundle found at $BUNDLE" >&2
  echo "og: run 'make og-update' (or 'pnpm build:desktop') first." >&2
  exit 1
fi

ELECTRON="$REPO/packages/desktop/node_modules/.bin/electron"
if [ ! -x "$ELECTRON" ]; then
  echo "og: electron not installed. Run 'pnpm install' from $REPO." >&2
  exit 1
fi

exec "$ELECTRON" "$BUNDLE" --cwd "$(cd "$TARGET" && pwd)"
